{
  "name": "@narratica/client-layout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./ui": {
      "types": "./lib/types/client/ui.d.ts",
      "default": "./lib/ui.js"
    },
    "./markdown": {
      "types": "./lib/types/client/markdown.d.ts",
      "default": "./lib/markdown.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-rc.3"
  },
  "files": [
    "lib"
  ],
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "marked": "18.1.1"
  }
}
