{
  "name": "@narratica/client-story-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@narratica/client-runtime",
        "@narratica/client-workspace",
        "@narratica/client-layout"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@narratica/contracts": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@narratica/client-runtime": "0.0.0",
    "@narratica/client-workspace": "0.0.0",
    "@narratica/client-layout": "0.0.0",
    "react": "^18.2.0"
  },
  "files": ["lib"]
}